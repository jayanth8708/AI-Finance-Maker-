```gitignore
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and build files
node_modules/
dist/
dist-ssr/
*.local

# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments and cache
.venv/
venv/
__pycache__/
*.py[cod]

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
```

